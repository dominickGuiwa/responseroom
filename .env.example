# Copy to .env (never commit .env). The server reads it at startup; values stay server-side.
# App-scoped API key from the ResponseRoom Scenario Builder agent page on agent.creao.ai (starts with capi_).
CREAO_API_KEY=
# Optional overrides
# CREAO_APP_ID=94bd717e-a1a6-49bf-82d9-6a5d64c2c720
# CREAO_BASE_URL=https://agent.creao.ai
# Debrief Coach (optional): a second CREAO agent that drafts instructor feedback from a finished run. Its own app id and app-scoped key.
CREAO_DEBRIEF_APP_ID=
CREAO_DEBRIEF_API_KEY=
# Caller agent (optional): a third CREAO agent that answers what the trainee says to the caller, in character (see agents/caller-agent.md).
CREAO_CALLER_APP_ID=
CREAO_CALLER_API_KEY=
# CREAO_CALLER_HOLD_MS=45000
# PORT=4173

# ElevenLabs (optional): voices for the caller, Fire and EMS, and transcription of what the trainee says (push-to-talk).
# Without it, the browser's own voices read messages and trainees type. Key from elevenlabs.io > Profile > API keys.
ELEVENLABS_API_KEY=
# Every call draws its caller, engine crew and medic voices from built-in pools of premade voices. Pin one voice per role:
# ELEVENLABS_VOICE_CALLER=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_FIRE=nPczCjzI2devNBz1zQrb
# ELEVENLABS_VOICE_EMS=Xb7hH8MSUJpSbSDYk0k2
# …or replace a pool with your own comma-separated voice ids:
# ELEVENLABS_VOICES_CALLER=id1,id2,id3
# ELEVENLABS_VOICE_DISPATCHER=XrExE9yKIg1WjnnlVkGX   (welcome demo only)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_DAILY_CHARS=40000

# Sentry (optional): DSN from your Sentry project's Settings > Client Keys (DSN). Errors and performance only; no trainee content is sent.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=local-demo
# SENTRY_TRACES_SAMPLE_RATE=1
