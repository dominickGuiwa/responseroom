# Copy to .env (never commit .env). The server reads it at startup; values stay server-side.
# App-scoped API key from the ResponseRoom Scenario Builder agent page on agent.creao.ai (starts with capi_).
CREAO_API_KEY=
# Optional overrides
# CREAO_APP_ID=94bd717e-a1a6-49bf-82d9-6a5d64c2c720
# CREAO_BASE_URL=https://agent.creao.ai
# Debrief Coach (optional): a second CREAO agent that drafts instructor feedback from a finished run. Its own app id and app-scoped key.
CREAO_DEBRIEF_APP_ID=
CREAO_DEBRIEF_API_KEY=
# PORT=4173

# Sentry (optional): DSN from your Sentry project's Settings > Client Keys (DSN). Errors and performance only; no trainee content is sent.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=local-demo
# SENTRY_TRACES_SAMPLE_RATE=1
